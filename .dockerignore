# Keep the build context small and secret-free.

# Secrets — never send env files to the Docker daemon.
.env
.env.*
!.env.example

# Dependencies and build output (rebuilt inside the image)
node_modules
.pnpm-store
.next
out
*.tsbuildinfo
next-env.d.ts

# Generated service worker files
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# VCS, CI, editor and OS noise
.git
.github
.vscode
.idea
.DS_Store
*.log

# Tests and reports (not needed to build or run the app)
tests
coverage
playwright-report
test-results
playwright.config.ts
vitest.config.ts

# Docker files themselves
Dockerfile
.dockerignore
compose.yaml

# Local bundles (rebuilt in the image)
dist
