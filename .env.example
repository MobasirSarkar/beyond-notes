# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon pooled URL works; keep sslmode=require).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 32+ random chars: `openssl rand -base64 48`
BETTER_AUTH_SECRET=""
# Public origin of the app (used for cookies / trusted origins).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: GitHub OAuth sign-in
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: Web Push reminders. Generate with `pnpm vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: protects /api/cron/reminders (`openssl rand -hex 32`).
CRON_SECRET=""
